<odoo>
    <data noupdate="1">
        <record id="ir_cron_sync_vat_exemption" model="ir.cron">
            <field name="name">TOConline: Atualizar Motivos de Isenção IVA</field>
            <field name="model_id" ref="model_account_l10n_pt_vat_exempt_reason"/>
            <field name="state">code</field>
            <field name="code">model.cron_update_vat_exemption_reasons()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 02:00:00')"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_retry_toc_invoices" model="ir.cron">
            <field name="name">TOConline: Retry pending/failed invoices</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_toc_invoices()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_retry_toc_pickings" model="ir.cron">
            <field name="name">TOConline: Retry pending/failed stock transfers</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_toc_pickings()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>