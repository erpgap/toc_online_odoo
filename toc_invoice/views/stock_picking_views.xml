<odoo>
    <record id="view_westminster_custom_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="priority">999</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='carrier_tracking_ref']" position="before">
                <field name="use_license_plate" invisible="company_id != 1" group="fleet.fleet_group_user"/>
                <field name="vehicle_id" invisible="not use_license_plate or company_id != 1" group="fleet.fleet_group_user"/>
            </xpath>
        </field>
    </record>
</odoo>