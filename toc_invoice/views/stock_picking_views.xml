<odoo>
    <record id="view_westminster_custom_picking_form" model="ir.ui.view">
        <field name="model">stock.picking</field>
        <field name="priority">999</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <div invisible="company_id != 1">
                    <field name="use_license_plate"/>
                    <field name="vehicle_id" invisible="not use_license_plate"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>