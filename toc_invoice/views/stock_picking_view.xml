<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_form_inherit_vat_reason" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.vat.reason</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="l10npt_vat_exempt_reason" readonly="sale_id or state == 'done'"/>
            </field>
        </field>
    </record>
</odoo>
