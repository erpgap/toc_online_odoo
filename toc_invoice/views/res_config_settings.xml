<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_toc_online" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.toc_online</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='account']" position="inside">
                    <block title="TOConline Configuration" id="toc_online_settings"
                        groups="account.group_account_manager">
                        <setting string="TOC Online"
                            help="Enable to send invoices and pickings to TOC Online">
                            <field name="toc_online_enabled"/>
                        </setting>
                        <setting></setting>
                        <setting string="TOConline Client ID"
                            invisible="not toc_online_enabled">
                            <field name="toc_online_client_id" style="width:100% !important;" required="toc_online_enabled"/>
                        </setting>
                        <setting string="OAuth Authentication URL"
                            invisible="not toc_online_enabled">
                            <field name="toc_auth_url"
                                placeholder="e.g. https://app11.toconline.pt/oauth"
                                style="width:100% !important;" required="toc_online_enabled"/>
                        </setting>
                        <setting string="TOConline Client Secret"
                            invisible="not toc_online_enabled">
                            <field name="toc_online_client_secret" password="True" style="width:100% !important;" required="toc_online_enabled"/>
                        </setting>
                        <setting string="API Base URL"
                            invisible="not toc_online_enabled">
                            <field name="toc_api_url"
                                placeholder="e.g. https://api11.toconline.pt"
                                style="width:100% !important;" required="toc_online_enabled"/>
                        </setting>
                        <setting string="AT Username"
                            invisible="not toc_online_enabled">
                            <field name="toc_at_username" style="width:100% !important;"/>
                        </setting>
                        <setting string="Redirect URI"
                            invisible="not toc_online_enabled">
                            <field name="toc_redirect_uri"
                                placeholder="e.g. https://oauth.pstmn.io/v1/callback"
                                style="width:100% !important;" required="toc_online_enabled"/>
                        </setting>
                        <setting string="AT Password"
                            invisible="not toc_online_enabled">
                            <field name="toc_at_password" password="True" style="width:100% !important;"/>
                        </setting>
                        <setting string="TOConline Company ID"
                                invisible="not toc_online_enabled or not toc_company_id">
                            <field name="toc_company_id"
                                readonly="1"
                                groups="base.group_system"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
