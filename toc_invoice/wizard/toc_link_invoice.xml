<odoo>
  <record id="view_toc_link_invoice_wizard" model="ir.ui.view">
    <field name="name">toc.link.invoice.wizard.form</field>
    <field name="model">toc.link.invoice.wizard</field>
    <field name="arch" type="xml">
      <form string="Link TOConline Invoice">
        <group>
          <field name="invoice_id" readonly="1"/>
          <field name="toc_document_no" placeholder="e.g. FT 2026/01"/>
        </group>
        <footer>
          <button string="Confirm" type="object" name="action_confirm_link" class="btn-primary"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_toc_link_invoice_wizard" model="ir.actions.act_window">
    <field name="name">Link TOConline Invoice</field>
    <field name="res_model">toc.link.invoice.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
